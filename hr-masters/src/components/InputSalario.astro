---
interface Props {
  id?: string;
  placeholder?: string;
  required?: boolean;
  value?: string | number;
}

const {
  id = "salario",
  placeholder = "R$ 0,00",
  required = false,
  value = "",
} = Astro.props;
---

<input
  id={id}
  name={id}
  type="text"
  inputmode="numeric"
  placeholder={placeholder}
  required={required}
  value={value}
  data-input-salario
/>

<script>
  import { formatSalario } from "@utils/salarioHandler";

  function setupSalario() {
    document
      .querySelectorAll<HTMLInputElement>("[data-input-salario]")
      .forEach((input) => {
        if (input.dataset.bound) return;
        input.dataset.bound = "true";

        input.addEventListener("input", (e) => {
          const el = e.target as HTMLInputElement;
          el.value = formatSalario(el.value);
        });
      });
  }

  setupSalario();
  document.addEventListener("astro:page-load", setupSalario);
</script>
