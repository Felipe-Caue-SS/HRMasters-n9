---
import InternoLayout from "../../layouts/InternoLayout.astro";

const usuario = {
    nome: "Cleiton",
    empresa: "Cleitinho Corp",
    cargo: "CEO",
    salario: 69000000,
    status: "ativo",
}
---

<InternoLayout titulo="Home" descricao="homepage dos funcionarios da hr masters">
    <h1>Home</h1>
    <p id="boas-vindas">Boas vindas, {usuario.nome}!</p>
    <p>O que deseja fazer hoje?</p>
</InternoLayout>


<style>

h1 {
    text-align: center;
    margin-top: 20px;
}

p {
    margin-top: 10px;
}

#boas-vindas {
    margin: 0;
    font-weight: 500;
    text-align: center;
    font-size: 1.5rem;
}

</style>
